#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative File.join("..", "lib", "brutal")

begin
  exit Brutal::CLI.run(ARGV)
rescue Interrupt
  # Aw has killed and reaped the child. End by the signal, as an interrupted
  # command does, so that a shell loop stops too, but without a backtrace.
  Signal.trap(:INT, "SYSTEM_DEFAULT")
  Process.kill(:INT, Process.pid)
end
